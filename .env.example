# Copy to .env and fill in only what you use. Never commit .env.

# "local" (free, default) or "hosted" (free route only, e.g. OpenRouter free tier)
DM_BACKEND=local

# --- hosted backend: FREE routes only, never a paid key ---
# OpenRouter offers a free route for Mercury Decide; a free account is enough.
DM_HOSTED_URL=https://openrouter.ai/api/v1
DM_API_KEY=
DM_HOSTED_MODEL=inception/mercury-decide

# --- local backend ---
DM_LOCAL_URL=http://localhost:11434/v1
DM_LOCAL_MODEL=tev1

# Training (notebook 04) and datasets (notebook 03)
DM_BASE_MODEL=Qwen/Qwen2.5-0.5B
HF_CACHE_DIR=./.cache/hf
SEED=42
